	<translation_packages>
		<translation_package>
			<name>main</name>
			<translation_urls>
				<translation_url>
					<path>public/i18n/en.json</path>
					<language>en-US</language>
				</translation_url>
				<translation_url>
					<path>public/i18n/ru.json</path>
					<language>ru-RU</language>
				</translation_url>
			</translation_urls>
		</translation_package>
	</translation_packages>
	<editor_configuration>
		<save_empty_translations>true</save_empty_translations>
		<translation_order>alphabetically</translation_order>
		<copy_templates>
			<copy_template>{{'%1' | translate}}</copy_template>
			<copy_template>[translate]=&quot;'%1'&quot;</copy_template>
			<copy_template>_('%1')</copy_template>
		</copy_templates>
		<custom_languages/>
		<id_extractor_ignores>
			<string>${this.prefix}${lang}${this.suffix}</string>
			<string>*</string>
			<string>Content-Type</string>
			<string>TaskTrackingZone</string>
			<string>content-length</string>
			<string>easing</string>
			<string>first</string>
			<string>items</string>
			<string>items.0.price</string>
			<string>last</string>
			<string>name</string>
			<string>offset</string>
			<string>person</string>
			<string>person.name</string>
			<string>pinch</string>
			<string>price</string>
			<string>rotate</string>
		</id_extractor_ignores>
	</editor_configuration>
	<primary_language>en-US</primary_language>
	<configuration>
		<indent>tab</indent>
		<format>json</format>
		<support_arrays>true</support_arrays>
	</configuration>
</babeledit_project>
